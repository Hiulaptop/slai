generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SlideGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SlideRevisionOperation {
  GENERATE
  EDIT
  UNDO
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  email        String     @unique @db.VarChar(320)
  passwordHash String     @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions         AuthSession[]
  slideGenerations SlideGeneration[]
  apiRequestLogs   ApiRequestLog[]
  systemLogs       SystemLog[]

  @@index([status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  refreshTokenHash String    @unique @db.Char(64)
  userAgent        String?   @db.VarChar(1000)
  ipAddress        String?   @db.VarChar(45)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SlideGeneration {
  id                    String                @id @default(uuid()) @db.Char(36)
  userId                String?               @db.Char(36)
  status                SlideGenerationStatus @default(PENDING)
  title                 String?               @db.VarChar(500)
  provider              String                @db.VarChar(50)
  modelId               String                @db.VarChar(255)
  requestPayload        Json
  responsePayload       Json?
  approvedOutline       Json?
  htmlContent           String?               @db.LongText
  currentRevisionNumber Int?
  nextRevisionNumber    Int                   @default(1)
  finishReason          String?               @db.VarChar(100)
  promptTokens          Int?
  completionTokens      Int?
  totalTokens           Int?
  errorCode             String?               @db.VarChar(100)
  errorMessage          String?               @db.Text
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiRequestLogs ApiRequestLog[]
  systemLogs     SystemLog[]
  revisions      SlideRevision[]
  elementNodes   SlideElementNode[]
  snapshots      SlideSnapshot[]

  @@index([userId, createdAt])
  @@index([userId, createdAt, id])
  @@index([status, createdAt])
  @@index([provider, modelId])
  @@map("slide_generations")
}

model SlideRevision {
  id                       String                 @id @default(uuid()) @db.Char(36)
  slideGenerationId        String                 @db.Char(36)
  revisionNumber           Int
  parentRevisionNumber     Int?
  operation                SlideRevisionOperation
  editRequest              Json?
  changedSlideNumbers      Json?
  htmlContent              String?                @db.LongText
  animationRegistryVersion Int?
  createdAt                DateTime               @default(now())

  slideGeneration SlideGeneration      @relation(fields: [slideGenerationId], references: [id], onDelete: Cascade)
  slides          SlideRevisionSlide[]

  @@unique([slideGenerationId, revisionNumber])
  @@index([slideGenerationId, parentRevisionNumber])
  @@map("slide_revisions")
}

// --- Structured slide document persistence (add-structured-slide-persistence) ---
//
// Additive, non-destructive: `SlideGeneration.htmlContent` and
// `SlideRevision.htmlContent` are retained (the latter is now nullable,
// since a structured-only revision writes no HTML) until the migration in
// design.md's "Migration Plan" reaches its destructive final step. Nothing
// here removes or repurposes an existing column.
//
// Structural sharing is content-addressed rather than reference-passed: a
// caller submits a self-contained flat node/edge graph per mutated slide,
// and the repository looks up `(slideGenerationId, contentHash)` before
// inserting - identical content already persisted for this generation is
// reused by ID instead of duplicated, which is what makes "reuse unchanged
// slides/elements across revisions" (design.md's structural-sharing
// requirement) work without the caller ever referencing old row IDs.
// Sharing is deliberately scoped per generation (not global) so a single
// cascade delete on `SlideGeneration` correctly removes every row this
// generation owns with no reference-counting or GC - see design.md's
// "Garbage collection... is deferred" and "rely on cascade deletion for
// projects first".

model SlideElementNode {
  id                String   @id @default(uuid()) @db.Char(36)
  slideGenerationId String   @db.Char(36)
  contentHash       String   @db.Char(64)
  type              String   @db.VarChar(100)
  schemaVersion     Int
  x                 Float?
  y                 Float?
  width             Float?
  height            Float?
  zIndex            Int?
  props             Json
  animationKey      String?  @db.VarChar(100)
  animationProps    Json?
  createdAt         DateTime @default(now())

  slideGeneration SlideGeneration        @relation(fields: [slideGenerationId], references: [id], onDelete: Cascade)
  childEdges      SlideElementChild[]    @relation("ElementParent")
  parentEdges     SlideElementChild[]    @relation("ElementChild")
  snapshotSlots   SlideSnapshotElement[]

  @@unique([slideGenerationId, contentHash])
  @@index([slideGenerationId, type])
  @@map("slide_element_nodes")
}

model SlideElementChild {
  parentElementNodeId String @db.Char(36)
  childElementNodeId  String @db.Char(36)
  slotKey             String @db.VarChar(100)
  orderIndex          Int

  parent SlideElementNode @relation("ElementParent", fields: [parentElementNodeId], references: [id], onDelete: Cascade)
  child  SlideElementNode @relation("ElementChild", fields: [childElementNodeId], references: [id], onDelete: Cascade)

  @@id([parentElementNodeId, slotKey])
  @@unique([parentElementNodeId, orderIndex])
  @@index([childElementNodeId])
  @@map("slide_element_children")
}

model SlideSnapshot {
  id                String   @id @default(uuid()) @db.Char(36)
  slideGenerationId String   @db.Char(36)
  contentHash       String   @db.Char(64)
  width             Float
  height            Float
  props             Json
  createdAt         DateTime @default(now())

  slideGeneration SlideGeneration        @relation(fields: [slideGenerationId], references: [id], onDelete: Cascade)
  elements        SlideSnapshotElement[]
  revisionSlides  SlideRevisionSlide[]

  @@unique([slideGenerationId, contentHash])
  @@index([slideGenerationId])
  @@map("slide_snapshots")
}

model SlideSnapshotElement {
  slideSnapshotId String @db.Char(36)
  orderIndex      Int
  elementNodeId   String @db.Char(36)

  snapshot SlideSnapshot    @relation(fields: [slideSnapshotId], references: [id], onDelete: Cascade)
  element  SlideElementNode @relation(fields: [elementNodeId], references: [id], onDelete: Cascade)

  @@id([slideSnapshotId, orderIndex])
  @@index([elementNodeId])
  @@map("slide_snapshot_elements")
}

model SlideRevisionSlide {
  slideRevisionId String @db.Char(36)
  slideNumber     Int
  slideSnapshotId String @db.Char(36)

  revision SlideRevision @relation(fields: [slideRevisionId], references: [id], onDelete: Cascade)
  snapshot SlideSnapshot @relation(fields: [slideSnapshotId], references: [id], onDelete: Cascade)

  @@id([slideRevisionId, slideNumber])
  @@index([slideSnapshotId])
  @@map("slide_revision_slides")
}

model ApiRequestLog {
  id                String   @id @default(uuid()) @db.Char(36)
  requestId         String   @unique @db.VarChar(100)
  userId            String?  @db.Char(36)
  slideGenerationId String?  @db.Char(36)
  method            String   @db.VarChar(10)
  path              String   @db.VarChar(2048)
  queryParams       Json?
  requestHeaders    Json?
  requestBody       Json?
  statusCode        Int?
  responseHeaders   Json?
  responseBody      Json?
  ipAddress         String?  @db.VarChar(45)
  userAgent         String?  @db.VarChar(1000)
  durationMs        Int?
  errorCode         String?  @db.VarChar(100)
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  slideGeneration SlideGeneration? @relation(fields: [slideGenerationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([slideGenerationId])
  @@index([method, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
  @@map("api_request_logs")
}

model SystemLog {
  id                String   @id @default(uuid()) @db.Char(36)
  level             LogLevel
  message           String   @db.Text
  service           String?  @db.VarChar(100)
  module            String?  @db.VarChar(100)
  event             String?  @db.VarChar(100)
  requestId         String?  @db.VarChar(100)
  userId            String?  @db.Char(36)
  slideGenerationId String?  @db.Char(36)
  context           Json?
  errorName         String?  @db.VarChar(255)
  errorStack        String?  @db.LongText
  createdAt         DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  slideGeneration SlideGeneration? @relation(fields: [slideGenerationId], references: [id], onDelete: SetNull)

  @@index([level, createdAt])
  @@index([requestId])
  @@index([userId, createdAt])
  @@index([slideGenerationId])
  @@index([service, createdAt])
  @@index([createdAt])
  @@map("system_logs")
}
